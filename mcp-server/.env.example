# Copy to .env for local use. In production, set these as real environment variables / secrets —
# never commit a filled-in .env.

NODE_ENV=production
PORT=8787

# This server's own public URL — its OAuth "resource" identifier (RFC 8707) and the audience a
# JWT must carry to be accepted. Must match whatever the client (or its authorization server) was
# told this server's address is.
PUBLIC_URL=https://mcp.yourdomain.com

# Comma-separated hostnames this process will accept a Host header from (DNS-rebinding protection).
# "any" disables the check — only safe behind a reverse proxy that already enforces it (see nginx/mcp.conf).
ALLOWED_HOSTS=mcp.yourdomain.com
# Comma-separated origins allowed to make browser-based (CORS) requests. Leave empty to block all
# browser-origin requests (server-to-server and CLI clients are unaffected — CORS only governs browsers).
ALLOWED_ORIGINS=

# --- JWT bearer verification (pick ONE, or neither to run API-key-only) ---
# Option A: a single shared secret, for a deployment where this server (or one you trust) issues
# its own tokens. Generate with: openssl rand -base64 32
JWT_HS256_SECRET=
# Option B: a JWKS URL, for verifying tokens issued by a real external identity provider
# (Auth0, Okta, Keycloak, Clerk, your own Authorization Server...).
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=

# Where tenant records live. See tenants.example.json and `npx tsx scripts/gen-key.ts` to provision one.
TENANTS_FILE=./tenants.json

# Default per-tenant rate limit (overridable per tenant in tenants.json).
RATE_LIMIT_POINTS=60
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=info
