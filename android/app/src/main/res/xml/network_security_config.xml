<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted for loopback only: the embedded server binds 127.0.0.1
  and serving it over TLS would mean shipping a certificate in the APK for no
  security gain. Everything outbound stays HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
