# ─── NVIDIA NIM ───────────────────────────────────────────────────────────────
# Get a key at https://build.nvidia.com (free developer tier).
# Server-side only. Never exposed to the browser.
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── Pollinations.ai (zero-key) ───────────────────────────────────────────────
# No key required. A referrer/token only raises rate limits on the free tier.
POLLINATIONS_TEXT_BASE_URL=https://text.pollinations.ai
POLLINATIONS_IMAGE_BASE_URL=https://image.pollinations.ai
POLLINATIONS_REFERRER=chomugiri
# POLLINATIONS_TOKEN=

# ─── Terminal Bridge ──────────────────────────────────────────────────────────
# Default tunnel URL pre-filled into Settings. Users can override in the UI.
# e.g. https://your-tunnel.ngrok-free.app  or  https://tunnel.example.com
NEXT_PUBLIC_DEFAULT_BRIDGE_URL=
# Shared secret printed by `npm run agent` on the host machine.
NEXT_PUBLIC_DEFAULT_BRIDGE_TOKEN=

# ─── Vercel deployment ────────────────────────────────────────────────────────
# Optional server-side fallback token. Users normally supply their own in Settings.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
