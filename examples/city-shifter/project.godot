; City Shifter: Sky Siege — co-op jetpack gauntlet game on a moving train, built for low-end phones.

config_version=5

[application]

config/name="City Shifter"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.07, 0.11, 0.25, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=3
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024
environment/defaults/default_clear_color=Color(0.07, 0.11, 0.25, 1)

[editor_plugins]

enabled=PackedStringArray()

[gdextension]

