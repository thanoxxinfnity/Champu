{
 "src": "raw/sukuna_tv.glb",
 "out": "raw/sukuna_tv_split.glb",
 "ratio": 0.32,
 "smooth": 3,
 "default": "pants",
 "rules": [
  {
   "part": "shoeL",
   "if": "(z < 0.06 and v < 0.35) and x > 0"
  },
  {
   "part": "shoeR",
   "if": "(z < 0.06 and v < 0.35) and x < 0"
  },
  {
   "part": "shinL",
   "if": "(z < 0.16) and x > 0"
  },
  {
   "part": "shinR",
   "if": "(z < 0.16) and x < 0"
  },
  {
   "part": "hair",
   "if": "z > 0.90 and v < 0.40"
  },
  {
   "part": "head",
   "if": "z > 0.80 and ax < 0.07"
  },
  {
   "part": "head",
   "if": "z > 0.76 and ax < 0.07 and v < 0.3"
  },
  {
   "part": "armL",
   "if": "(z > 0.62 and ax > 0.115 and (s > 0.06 or v < 0.3)) and x > 0"
  },
  {
   "part": "armR",
   "if": "(z > 0.62 and ax > 0.115 and (s > 0.06 or v < 0.3)) and x < 0"
  },
  {
   "part": "sash",
   "if": "z > 0.45 and z < 0.64 and v < 0.3"
  },
  {
   "part": "top",
   "if": "z > 0.64"
  }
 ]
}